# ===== Sitio =====
# URL pública (local: http://localhost:3000 | Vercel: https://tu-dominio.com)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Correo de contacto para derechos ARCO (se muestra en /privacidad)
NEXT_PUBLIC_PRIVACY_EMAIL=

# ===== Supabase (Project Settings > API) =====
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Clave pública (anon/publishable). Es seguro exponerla: la protección real son las políticas RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave SECRETA (service_role). SOLO servidor. Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ===== IA de lenguaje (servidor) =====
# Proveedores soportados: anthropic | openai-compatible
# Si LLM_API_KEY queda vacío, las funciones de IA se muestran como "no disponibles" (no se simulan).
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5-5
# Solo para openai-compatible (ej. https://api.openai.com/v1). Para anthropic se ignora.
LLM_BASE_URL=

# ===== Transcripción de voz (servidor) =====
# API compatible con POST {BASE_URL}/audio/transcriptions (multipart). Vacío = no disponible.
TRANSCRIBE_BASE_URL=https://api.openai.com/v1
TRANSCRIBE_API_KEY=
TRANSCRIBE_MODEL=whisper-1

# ===== Límites de uso de IA (mensajes por ventana) =====
AI_RATE_LIMIT_MAX=20
AI_RATE_LIMIT_WINDOW_SECONDS=600

# ===== Datos de demostración =====
# Solo para el script `npm run seed:demo` (usa SUPABASE_SERVICE_ROLE_KEY).
# Los datos demo llevan is_demo=true y se excluyen de las estadísticas por defecto.
DEMO_PASSWORD=Demo-Porvenir-2026!
